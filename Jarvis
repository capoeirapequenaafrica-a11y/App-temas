  };

  function formacaoResp(texto) {
    var t = jNorm(texto);
    var I = INDEX_FORMACAO_PROFESSOR;
    var tema = /aquec|along|flexib|mobilid|quadril|cars|pnf|protocolo|formacao|dar aula|aquecer|esticar/.test(t);
    if (!tema) return null;
    if (/diferenca|vs|o que e|definicao/.test(t) && /aquec|along|mobil|flexib/.test(t)) {
      return '📚 Definições:\n\n🔥 Aquecimento: ' + I.definicoes.aquecimento + '\n\n🧘 Alongamento: ' + I.definicoes.alongamento + '\n\n📏 Flexibilidade: ' + I.definicoes.flexibilidade + '\n\n🎯 Mobilidade: ' + I.definicoes.mobilidade + '\n\n💡 ' + I.resumoChave;
    }
    if (/aquec/.test(t)) return '🔥 Aquecimento\n\nObjetivos:\n• ' + I.aquecimento.objetivos.join('\n• ') + '\n\nEstrutura:\n' + I.aquecimento.estrutura.join('\n') + '\n\nEvidência:\n• ' + I.aquecimento.evidencia.join('\n• ');
    if (/along|esticar|pnf|estatico/.test(t)) return '🧘 Alongam
