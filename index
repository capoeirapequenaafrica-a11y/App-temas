  /* botão "vou comparecer hoje" */
  var aulaHoje = aulaDeHoje();
  var btn = $('btnConfirmarPresencaHoje');
  var txt = $('txtJaConfirmouHoje');
  var aluno = alunoLogado() || nomeCheckinAtual();
  var jaConfirmou = false;
