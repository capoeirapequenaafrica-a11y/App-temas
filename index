function validarCheckinGympassNuvem() {
  var nome = ($('gympassAlunoNome').value || '').trim();
  var token = ($('gympassTokenVal').value || '').replace(/\D/g, '');
  if (nome.length < 3) { mostrarToast('Informe o nome do aluno.', 'erro'); return; }
  if (!/^\d{6}$/.test(token)) { mostrarToast('O token Wellhub deve ter 6 dígitos.', 'erro'); return; }

  var aluno = encontrarAlunoPorNome(nome);
  var jaExiste = obterCheckinDoDia(aluno || nome);
  if (jaExiste) {
    mostrarToast('Este aluno já possui check-in hoje. Só é permitido um por aula.', 'erro');
    return;
  }

  var limite = Date.now() - 24 * 60 * 60 * 1000;
  var reutilizado = DB.listar('presencas').some(function (p) {
    return p.token === token && new Date(p.criadoEm || 0).getTime() > limite;
  });
  if (reutilizado) { mostrarToast('Este token já foi utilizado nas últimas 24 horas.', 'erro'); return; }

  var polo = (DB.listar('polos')[0] || null);

  DB.salvar('presencas', {
    alunoId: aluno ? aluno.id : '',
    alunoNome: aluno ? aluno.nome : nome,
    alunoApelido: aluno ? (aluno.apelido || '') : '',
    poloId: polo ? polo.id : '',
    poloNome: polo ? polo.nome : 'Capoeira na Pequena África',
    data: dataLocalISO(),
    hora: horaLocalHM(),
    tipo: 'gympass',
    status: 'pendente',
    token: token,
    atrasoMin: 0,
    justificativa: '',
    criadoEm: agoraISO()
  }).then(function () {
    $('gympassTokenVal').value = '';
    mostrarToast('Token Gympass validado!');
    abrirModal('Check-in Gympass registrado',
      '<div style="text-align:center; padding:6px 0;">' +
        '<div style="font-size:2rem; color:var(--gympass-red); margin-bottom:8px;"><i class="fas fa-ticket-alt"></i></div>' +
        '<p style="font-size:0.9rem; margin-bottom:6px;"><strong>Token validado com sucesso!</strong></p>' +
        '<p class="mini">Aluno: <b>' + esc(aluno ? aluno.nome : nome) + '</b></p>' +
        '<p class="mini">Data: <b>' + dataBR(dataLocalISO()) + '</b></p>' +
        '<p class="mini" style="margin-top:8px; color:var(--gold);">Status: <b>PENDENTE</b> — aguarde aprovação do professor.</p>' +
      '</div>');
    renderCheckin();
  });
}

