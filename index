      (m.texto ? '<div>' + esc(m.texto) + '</div>' : '') +
      (m.imagem && urlSegura(m.imagem) ? '<img src="' + urlSegura(m.imagem) + '" alt="Foto enviada no mural">' : '') + '</div>';
  });
